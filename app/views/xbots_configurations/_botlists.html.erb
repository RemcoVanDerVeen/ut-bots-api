<div class="table table-nested">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Is Enabled</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% collection.each do |botlist| %>
        <tr>
          <td><%= botlist.name %></td>
          <td><%= botlist.description %></td>
          <td><%= botlist.is_enabled %></td>
          <td><%= link_to "Show", botlist_path(botlist), class: "btn btn-sm" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
