<p style="color: green"><%= notice %></p>

<h1>Maps</h1>

<%= link_to "New map", new_map_path, class: "btn btn-primary" %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Vanilla</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @maps.each do |map| %>
      <tr>
        <td><%= map.name %></td>
        <td><%= map.description.presence || '-' %></td>
        <td><%= map.vanilla? ? "Yes" : "No" %></td>
        <td><%= link_to "Show", map_path(map), class: "btn btn-sm" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
