<p style="color: green"><%= notice %></p>

<h1>Player models</h1>

<%= link_to "New player model", new_player_model_path, class: "btn btn-primary" %>

<div id="player_models">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Vanilla</th>
        <th>UT Value</th>
        <th>Number of Skins</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @player_models.each do |player_model| %>
        <tr>
          <td><%= player_model.name %></td>
          <td><%= player_model.vanilla ? "Yes" : "No" %></td>
          <td class="ut-value"><%= player_model.ut_value %></td>
          <td><%= player_model.player_model_skins.count %></td>
          <td><%= link_to "Show", player_model_path(player_model), class: "btn btn-sm" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
