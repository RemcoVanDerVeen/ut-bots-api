<div dom-id="<%= @player_model %>" class="card">
  <p style="color: green"><%= notice %></p>

  <h1><%= @player_model.name %></h1>

  <%= link_to "Return to index", player_models_path, class: "btn btn-primary btn-sm" %>
  <%= link_to "Edit", edit_player_model_path(@player_model), class: "btn btn-primary btn-sm" %>
  <%= button_to "Destroy", @player_model, method: :delete, class: "btn btn-outline-danger btn-sm" %>

  <h4>Description</h4>
  <p><%= @player_model.description.presence || '-' %></p>

  <h4>Vanilla?</h4>
  <p><%= @player_model.vanilla? ? "Yes" : "No" %></p>

  <h4>UT Value</h4>
  <p class="ut-value"><%= @player_model.ut_value %></p>

  <% if @player_model.player_model_skins.any? %>
    <h4>Associated player model skins</h4>
    <%= render "skins", collection: @player_model.player_model_skins %>
  <% end %>

  <% if @player_model.bots.any? %>
    <h4>Associated bots</h4>
    <%= render "shared/bots", collection: @player_model.bots %>
  <% end %>

  <% if @player_model.voice_packs.any? %>
    <h4>Associated voice packs</h4>
    <%= render "voice_packs", collection: @player_model.voice_packs %>
  <% end %>
</div>
