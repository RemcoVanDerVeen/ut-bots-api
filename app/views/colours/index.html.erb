<p style="color: green"><%= notice %></p>

<h1>Team Colours</h1>

<div id="colours">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>UT value</th>
      </tr>
    </thead>
    <tbody>
      <% @colours.each do |colour| %>
        <tr style="color: <%= colour.hex %>">
          <td><%= colour.name %></td>
          <td><%= colour.ut_value %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
