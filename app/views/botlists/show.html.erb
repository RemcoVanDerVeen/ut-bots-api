<p style="color: green"><%= notice %></p>

<h1><%= @botlist.name %></h1>

<%= link_to "Edit this botlist", edit_botlist_path(@botlist), class: "btn btn-primary" %>
<%= link_to "Back to botlists", botlists_path, class: "btn btn-primary" %>
<%= button_to "Destroy this botlist", @botlist, method: :delete, class: "btn btn-danger" %>

<h4>Description</h4>
<p><%= @botlist.description %></p>

<h4>Is Enabled</h4>
<p><%= @botlist.is_enabled ? "Yes" : "No" %></p>

<h4>Bots</h4>
<%= render "shared/bots", collection: @botlist.bots %>
