<p style="color: green"><%= notice %></p>

<h1>Authors</h1>

<%= link_to "New author", new_author_path, class: "btn btn-primary" %>

<div id="authors">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Nickname</th>
        <th>Number of Authorables</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @authors.each do |author| %>
        <tr>
          <td><%= author.name %></td>
          <td><%= author.nickname %></td>
          <td><%= author.author_authorables.count %></td>
          <td><%= link_to "Show", author_path(author), class: "btn btn-sm" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
